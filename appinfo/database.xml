<?xml version="1.0" encoding="UTF-8" ?>
<database>
    <name>*dbname*</name>
    <create>true</create>
    <overwrite>false</overwrite>
    <charset>utf8mb4</charset>
    
    <!-- Pricing Data Table -->
    <table>
        <name>*dbprefix*door_estimator_pricing</name>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
                <autoincrement>1</autoincrement>
                <primary>true</primary>
            </field>
            <field>
                <name>category</name>
                <type>text</type>
                <length>50</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>subcategory</name>
                <type>text</type>
                <length>100</length>
                <notnull>false</notnull>
            </field>
            <field>
                <name>item_name</name>
                <type>text</type>
                <length>255</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>price</name>
                <type>decimal</type>
                <precision>10</precision>
                <scale>2</scale>
                <notnull>true</notnull>
            </field>
            <field>
                <name>stock_status</name>
                <type>text</type>
                <length>20</length>
                <default>stock</default>
                <notnull>true</notnull>
            </field>
            <field>
                <name>description</name>
                <type>clob</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>created_at</name>
                <type>timestamp</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>updated_at</name>
                <type>timestamp</type>
                <notnull>true</notnull>
            </field>
            <index>
                <name>idx_door_estimator_pricing_category</name>
                <field>
                    <name>category</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_pricing_item_name</name>
                <field>
                    <name>item_name</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_pricing_category_subcategory</name>
                <field>
                    <name>category</name>
                </field>
                <field>
                    <name>subcategory</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_pricing_search</name>
                <field>
                    <name>item_name</name>
                </field>
                <field>
                    <name>category</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_pricing_price</name>
                <field>
                    <name>price</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_pricing_updated_at</name>
                <field>
                    <name>updated_at</name>
                </field>
            </index>
        </declaration>
    </table>

    <!-- Quotes Table -->
    <table>
        <name>*dbprefix*door_estimator_quotes</name>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <default>0</default>
                <notnull>true</notnull>
                <autoincrement>1</autoincrement>
                <primary>true</primary>
            </field>
            <field>
                <name>user_id</name>
                <type>text</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>quote_name</name>
                <type>text</type>
                <length>255</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>customer_info</name>
                <type>clob</type>
                <notnull>false</notnull>
            </field>
            <field>
                <name>quote_data</name>
                <type>clob</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>markups</name>
                <type>clob</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>total_amount</name>
                <type>decimal</type>
                <precision>12</precision>
                <scale>2</scale>
                <notnull>true</notnull>
            </field>
            <field>
                <name>created_at</name>
                <type>timestamp</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>updated_at</name>
                <type>timestamp</type>
                <notnull>true</notnull>
            </field>
            <index>
                <name>idx_door_estimator_quotes_user_id</name>
                <field>
                    <name>user_id</name>
                </field>
            </index>
            <index>
                <name>idx_door_estimator_quotes_updated_at</name>
                <field>
                    <name>updated_at</name>
                </field>
            </index>
        </declaration>
    </table>
</database>